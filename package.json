{
    "name": "numero-secreto1",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "start": "python3 -m http.server 8080 --bind 127.0.0.1",
        "format": "prettier --write .",
        "lint": "eslint --max-warnings 0 . && stylelint --max-warnings 0 style.css && html-validate --max-warnings 0 index.html && prettier --check .",
        "test": "vitest run --coverage",
        "test:browser": "playwright test",
        "check": "npm run lint && npm test"
    },
    "devDependencies": {
        "@eslint/js": "9.39.5",
        "@playwright/test": "1.65.1",
        "@vitest/coverage-v8": "5.1.2",
        "eslint": "9.39.5",
        "globals": "^17.0.0",
        "html-validate": "11.22.1",
        "prettier": "3.10.1",
        "stylelint": "18.1.0",
        "stylelint-config-standard": "41.1.0",
        "vitest": "5.1.2"
    }
}
